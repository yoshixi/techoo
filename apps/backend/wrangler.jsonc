{
	"$schema": "node_modules/wrangler/config-schema.json",
	"compatibility_date": "2025-08-03",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"name": "techoo-backend",
	"main": "./src/index.tsx",
	// Encrypted sync log for `wrangler dev` and tests. `d1_databases` is not
	// inherited by `--env prod`, so a production deploy keeps working without
	// this binding. After `wrangler d1 create techoo-sync`, copy this block
	// into `env.prod` with the real database_id, then run `d1:migrate:prod`.
	// Until then the new routes answer 503 and the Turso API is unchanged.
	"d1_databases": [
		{
			"binding": "SYNC_DB",
			"database_name": "techoo-sync",
			"database_id": "00000000-0000-0000-0000-000000000000",
			"migrations_dir": "sync-migrations"
		}
	],
	"vars": {
		"NODE_ENV": "production",
		"BETTER_AUTH_URL": "http://localhost:8787",
		"GOOGLE_REDIRECT_URI": "http://localhost:8787/api/auth/callback/google",
		// Remaining env vars (BETTER_AUTH_SECRET, JWT_SECRET, GOOGLE_CLIENT_ID,
		// GOOGLE_CLIENT_SECRET, TURSO_MAIN_DB_URL, TURSO_MAIN_DB_AUTH_TOKEN,
		// TURSO_ORG_SLUG, TURSO_API_TOKEN, TURSO_GROUP, TURSO_GROUP_AUTH_TOKEN,
		// TURSO_SEED_DB_NAME) are stored as secrets via `wrangler secret put`
	},
	"env": {
		"prod": {
			"name": "techoo-backend-prod",
			"vars": {
				"NODE_ENV": "production",
				"BETTER_AUTH_URL": "https://api.techoo.app",
				"GOOGLE_REDIRECT_URI": "https://api.techoo.app/api/auth/callback/google",
				// Secrets stored via `wrangler secret put --env prod`.
				// SYNC_DB is added here after `wrangler d1 create techoo-sync`.
			},
			"placement": {
				"mode": "targeted",
        "region": "aws:us-east-1",
			},
			"routes": [
				{
					"pattern": "api.techoo.app",
					"custom_domain": true,
					"zone_name": "techoo.app",
				}
			]
		}
	},
	"observability": {
		"enabled": false,
		"head_sampling_rate": 1,
		"logs": {
			"enabled": true,
			"head_sampling_rate": 1,
			"persist": true,
			"invocation_logs": true
		},
		"traces": {
			"enabled": true,
			"persist": true,
			"head_sampling_rate": 1
		}
	}
}

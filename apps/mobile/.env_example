# Copy to .env.local for local development (.env.local is gitignored).
#
# Local backend (Wrangler default). iOS Simulator can use localhost; physical device
# or Android emulator may need your machine's LAN IP, e.g. http://192.168.1.10:8787
EXPO_PUBLIC_API_BASE_URL=http://localhost:8787

# API error alerts: append HTTP status, response body, and stack traces (default off unless `pnpm run dev`).
# DEBUG=true
